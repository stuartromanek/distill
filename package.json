{
  "name": "distill",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:https": "DST_HTTPS=1 nuxt dev",
    "setup": "node --experimental-strip-types scripts/setup.mts",
    "export-fixtures": "node --experimental-strip-types scripts/export-fixtures.mts",
    "eval:matches": "node --experimental-strip-types scripts/eval-matches.mts",
    "debug:parse": "node --experimental-strip-types scripts/debug-parse.mts",
    "eval:image": "node --experimental-strip-types scripts/eval-image-parse.mts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:scoring": "node --experimental-strip-types scripts/match-scoring.test.mts",
    "test:llm-parse": "node --experimental-strip-types scripts/llm-parse.test.mts",
    "print-refresh-token": "node --experimental-strip-types scripts/print-refresh-token.mts",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@webtui/css": "^0.1.7",
    "nuxt": "^4.4.6",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
