NUXT_TIDAL_CLIENT_ID=
NUXT_TIDAL_CLIENT_SECRET=
NUXT_TIDAL_REDIRECT_URI=http://localhost:3000/api/oauth/callback/tidal
NUXT_TIDAL_COUNTRY_CODE=US
# Tidal API throttle (optional — defaults shown)
NUXT_TIDAL_MAX_CONCURRENT=1
NUXT_TIDAL_MIN_INTERVAL_MS=300
NUXT_TIDAL_MAX_RETRIES=5
NUXT_SESSION_PASSWORD=

# LLM — default uses Cursor via cursor-api-proxy (see README)
NUXT_LLM_PROVIDER=cursor
NUXT_CURSOR_API_KEY=
NUXT_CURSOR_PROXY_URL=http://127.0.0.1:8765
NUXT_OPENAI_MODEL=auto

# OpenAI (set NUXT_LLM_PROVIDER=openai, or used as vision fallback for cursor+images)
NUXT_OPENAI_API_KEY=
NUXT_OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (set NUXT_LLM_PROVIDER=gemini — supports text + images natively)
NUXT_GEMINI_API_KEY=
NUXT_GEMINI_MODEL=gemini-2.5-flash
NUXT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic (reserved — NUXT_LLM_PROVIDER=anthropic not yet implemented)
NUXT_ANTHROPIC_API_KEY=
NUXT_ANTHROPIC_MODEL=claude-sonnet-4-20250514
NUXT_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# CLI export-fixtures — plain refresh token (not JSON). Get from /api/dev/tidal-refresh-token
TIDAL_REFRESH_TOKEN=
