# --- Required ---

# Cookie/session encryption (16+ chars). Generated by: pnpm setup
# Distill reads only DST_* keys — generic names like OPENAI_API_KEY are ignored.
DST_SESSION_PASSWORD=

# --- Streaming OAuth (configure at least one) ---

# Tidal — https://developer.tidal.com/dashboard
# Register redirect: http://localhost:3000/api/oauth/callback/tidal
DST_TIDAL_CLIENT_ID=

# Spotify — https://developer.spotify.com/dashboard
# Spotify requires HTTPS redirect URIs (localhost is not allowed).
# Local HTTPS: pnpm dev:https, open https://127.0.0.1:3000, register:
#   https://127.0.0.1:3000/api/oauth/callback/spotify
# Optional: DST_PUBLIC_URL=https://127.0.0.1:3000 (force OAuth callback origin)
# Dev mode: add your Spotify email under User Management in the dashboard
DST_SPOTIFY_CLIENT_ID=

# --- LLM (at least one API key) ---

# Optional server lock: openai | gemini (overrides UI picker)
# DST_LLM_PROVIDER=openai
# DST_LLM_PROVIDER=gemini

DST_OPENAI_API_KEY=
DST_OPENAI_MODEL=auto
DST_OPENAI_BASE_URL=https://api.openai.com/v1

DST_GEMINI_API_KEY=
DST_GEMINI_MODEL=gemini-2.5-flash
DST_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Anthropic (reserved — not yet implemented)
DST_ANTHROPIC_API_KEY=
DST_ANTHROPIC_MODEL=claude-sonnet-4-20250514
DST_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Optional: override LLM system prompts (use \n for line breaks in a single-line value)
# DST_LLM_EXTRACT_SYSTEM_PROMPT=
# DST_LLM_PLAYLIST_METADATA_SYSTEM_PROMPT=
#
# Default DST_LLM_EXTRACT_SYSTEM_PROMPT:
# You extract song titles and artists from user-provided text and images.
# Return ONLY valid JSON: { "songs": [{ "title", "artist", "album?", "confidence": "high"|"medium"|"low", "source": "text"|"image" }] }
# Rules:
# - Handle numbered lists, "Artist — Title", setlists, screenshots, social posts
# - Deduplicate by artist+title (case insensitive)
# - Omit non-song content (headers, dates, venue names without songs)
# - If unsure, use lower confidence
# - album is optional
#
# Default DST_LLM_PLAYLIST_METADATA_SYSTEM_PROMPT:
# You create concise playlist metadata from a track list.
# Return ONLY valid JSON: { "name": string, "description": string }
# Rules:
# - name should be short, natural, and playlist-like
# - description should be one sentence, no more than 140 characters
# - Do not mention that you are an AI
# - Do not include markdown

# --- Tidal optional tuning ---

DST_TIDAL_COUNTRY_CODE=US
DST_TIDAL_MAX_CONCURRENT=1
DST_TIDAL_MIN_INTERVAL_MS=300
DST_TIDAL_MAX_RETRIES=5

# --- CLI / dev helpers (not required for the web app) ---

# Client credentials for eval scripts (pnpm eval:matches)
DST_TIDAL_CLIENT_SECRET=

# User refresh token for export-fixtures — from /api/dev/tidal-refresh-token
DST_TIDAL_REFRESH_TOKEN=

# Dev server URL for print-refresh-token when not on port 3000
DST_DEV_URL=http://localhost:3000

# Optional: local HTTPS dev server (pnpm dev:https) for Spotify OAuth
# DST_HTTPS=1
# DST_PUBLIC_URL=https://127.0.0.1:3000

# Optional local-only dev port (do not change repo defaults; set in your gitignored .env)
# PORT=3002
# NUXT_HOST=::
# Custom port + dual-stack bind if browsers show "Upgrade Required" — see docs/configuration.md
